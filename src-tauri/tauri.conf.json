{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "声译 · 实时字幕工作台",
  "version": "0.1.22",
  "identifier": "com.codex.voice-caption-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "声译 · 实时字幕工作台",
        "width": 1400,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": [
      "sidecars/whisper_worker.py",
      "sidecars/requirements.txt"
    ]
  }
}
